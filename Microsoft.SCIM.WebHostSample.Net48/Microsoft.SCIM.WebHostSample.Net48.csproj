<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Microsoft.SCIM.WebHostSample.Net48</AssemblyName>
    <RootNamespace>Microsoft.SCIM.WebHostSample</RootNamespace>
    <!--
      Microsoft.Owin.Security.Jwt 4.2.2 was built against System.IdentityModel.Tokens.Jwt 5.x
      and NuGet unifies the whole graph on 8.x. Letting the SDK generate the binding redirects
      is what makes that unification actually load at runtime. See MULTI-TARGET-PLAN.md D19/R6.
    -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!--
      x64 rather than Any CPU, because of the SQLite the database provider uses. SQLitePCLRaw
      carries a native e_sqlite3 per architecture, and an Any CPU build copies one of them into
      the output with nothing to say which - here the x86 one, next to a process the runtime
      starts 64-bit, which fails at the first connection with a BadImageFormatException. Naming
      the platform makes the build copy the native that matches.
    -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.OwinSelfHost" Version="5.2.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <!-- IAppBuilder. Transitive, but referenced directly because Startup.cs names it. -->
    <PackageReference Include="Owin" Version="1.0.0" />
    <!--
      Pinned, not incidental: Microsoft.Owin.Security.Jwt 4.2.2 pulls Newtonsoft.Json 10.0.3
      transitively, which carries GHSA-5crp-9r3c-p9vr. Today the resolved version is 13.0.3 only
      because Microsoft.SCIM.Core pins it and the higher version wins, so dropping that reference
      would quietly reintroduce the vulnerable one with no restore warning.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Owin.Security.Jwt" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The database-backed sample provider (SCIM_PROVIDER=database). Dapper rather than an ORM
      because Domain already maps a row to an entity by hand; SQLite because it needs no server
      and runs on both sample legs.
    -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!--
      Pinned, not incidental: Microsoft.Data.Sqlite 10.0.0 resolves SQLitePCLRaw 2.1.11
      transitively, whose bundled SQLite carries GHSA-2m69-gcr7-jv3q. 3.0.0 is the lowest
      version restore accepts without that warning; 3.0.4 pulls a native package that refuses
      an Any CPU build, which is what both net48 samples are.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.SCIM.AspNet\Microsoft.SCIM.AspNet.csproj" />
    <!-- Selected at startup by SCIM_PROVIDER=edupass; see Startup.cs. -->
    <ProjectReference Include="..\SCIM.EduPass\SCIM.EduPass.csproj" />
  </ItemGroup>

  <!--
    The provider, the sample schema resources, the startup banner and the configuration files
    are single-sourced from the net10.0 sample rather than copied, so the two samples cannot
    drift apart. See MULTI-TARGET-PLAN.md D6.
  -->
  <ItemGroup>
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Domain\**\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Provider\**\*.cs" Link="Provider\%(Filename)%(Extension)" />
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Resources\**\*.cs" Link="Resources\%(Filename)%(Extension)" />
    <Compile Include="..\Microsoft.SCIM.WebHostSample\SampleStartupBanner.cs" Link="SampleStartupBanner.cs" />
    <None Include="..\Microsoft.SCIM.WebHostSample\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
