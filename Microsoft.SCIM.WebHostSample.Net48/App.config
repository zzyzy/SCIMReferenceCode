<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    Binding redirects are generated into Microsoft.SCIM.WebHostSample.Net48.exe.config at
    build time (AutoGenerateBindingRedirects in the .csproj). They are needed because
    Microsoft.Owin.Security.Jwt 4.2.2 references System.IdentityModel.Tokens.Jwt 5.x while
    the rest of the graph unifies on 8.x - see MULTI-TARGET-PLAN.md D19 and R6. Do not add
    hand-written <assemblyBinding> entries here unless the generated ones prove insufficient.
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>
