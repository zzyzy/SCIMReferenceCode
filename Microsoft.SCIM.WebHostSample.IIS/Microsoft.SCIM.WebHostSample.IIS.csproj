<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demonstrates docs/integration-guide.md Option A: adding the SCIM endpoints to an application
    that already has its own ASP.NET Web API surface, hosted under System.Web (IIS).

    Microsoft.SCIM.WebHostSample.Net48 stays as it is - an OWIN self-host that runs with F5.
    This project is the counterpart for the deployment shape most consumers actually have.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Microsoft.SCIM.WebHostSample.IIS</AssemblyName>
    <RootNamespace>Microsoft.SCIM.WebHostSample.IIS</RootNamespace>

    <!--
      IIS expects an application folder containing Web.config and bin\*.dll. The SDK's default
      bin\<Configuration>\<TargetFramework>\ layout is not that, so it is flattened here and
      the project folder itself becomes the application root. The trade-off is that Debug and
      Release write to the same place; a real application would publish instead.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>

    <!--
      x64 rather than Any CPU, for the same reason as Microsoft.SCIM.WebHostSample.Net48: the
      SQLite the database provider uses ships a native library per architecture, and an Any CPU
      build copies one with nothing to say which. This project is also the application folder,
      so that copy is what IIS loads - which means the application pool has to be 64-bit, as it
      is by default. A 32-bit pool needs this set to x86 instead.
    -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- Global.asax is application markup, not content to compile or copy. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The OWIN pipeline, hosted by System.Web rather than by HttpListener. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Owin" Version="5.2.9" />
    <!-- The pre-existing application's own Web API surface, on GlobalConfiguration. -->
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.9" />
    <!--
      Pinned, not incidental: Microsoft.Owin.Security.Jwt 4.2.2 pulls Newtonsoft.Json 10.0.3
      transitively, which carries GHSA-5crp-9r3c-p9vr. Today the resolved version is 13.0.3 only
      because Microsoft.SCIM.Core pins it and the higher version wins, so dropping that reference
      would quietly reintroduce the vulnerable one with no restore warning.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Owin.Security.Jwt" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpRuntime.BinDirectory, and the System.Web hosting types generally. -->
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The database-backed sample provider (SCIM_PROVIDER=database). Dapper rather than an ORM
      because Domain already maps a row to an entity by hand; SQLite because it needs no server
      and runs on both sample legs.
    -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!--
      Pinned, not incidental: Microsoft.Data.Sqlite 10.0.0 resolves SQLitePCLRaw 2.1.11
      transitively, whose bundled SQLite carries GHSA-2m69-gcr7-jv3q. 3.0.0 is the lowest
      version restore accepts without that warning; 3.0.4 pulls a native package that refuses
      an Any CPU build, which is what both net48 samples are.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.SCIM.AspNet\Microsoft.SCIM.AspNet.csproj" />
  </ItemGroup>

  <!--
    The provider, the sample schema resources, the configuration files and the sample token
    issuer are single-sourced from the other two samples rather than copied. See
    MULTI-TARGET-PLAN.md D6.
  -->
  <ItemGroup>
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Domain\**\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Provider\**\*.cs" Link="Provider\%(Filename)%(Extension)" />
    <Compile Include="..\Microsoft.SCIM.WebHostSample\Resources\**\*.cs" Link="Resources\%(Filename)%(Extension)" />
    <None Include="..\Microsoft.SCIM.WebHostSample\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Flattens the SQLite native library into the application's bin folder.

    An executable project gets this from the SDK, but a library one leaves the native in a
    runtimes/(rid)/native/ folder - and .NET Framework's DllImport probes the application base,
    not that folder, so the first connection fails with a DllNotFoundException. This project is
    the application folder, so the copy has to happen here rather than downstream of it.
  -->
  <Target Name="CopyNativeSqliteToOutput" AfterTargets="Build">
    <ItemGroup>
      <NativeSqlite Include="$(OutputPath)runtimes/win-$(PlatformTarget)/native/e_sqlite3.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeSqlite)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
